        "model": "core.exercisetype", 
        "fields": {
            "name": "\u0412\u044b\u0431\u0435\u0440\u0438 \u043f\u0435\u0440\u0435\u0432\u043e\u0434", 
            "description": "\u041f\u043e\u043a\u0430\u0437\u044b\u0432\u0430\u0435\u0442\u0441\u044f \u0441\u043b\u043e\u0432\u043e \u0438 \u043f\u0440\u0435\u0434\u043b\u0430\u0433\u0430\u0435\u0442\u0441\u044f \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u043e (5-7) \u0432\u0430\u0440\u0438\u0430\u043d\u0442\u043e\u0432 \u043f\u0435\u0440\u0435\u0432\u043e\u0434\u0430. \u041d\u0443\u0436\u043d\u043e \u0432\u044b\u0431\u0440\u0430\u0442\u044c \u0432\u0435\u0440\u043d\u044b\u0439 \u0432\u0430\u0440\u0438\u0430\u043d\u0442."
        }
    }, 
    {
        "pk": 2, 
        "model": "core.exercisetype", 
        "fields": {
            "name": "\u0423\u0433\u0430\u0434\u0430\u0439 \u0441\u043b\u043e\u0432\u043e", 
            "description": "\u041e\u0442\u043e\u0431\u0440\u0430\u0436\u0430\u0435\u0442\u0441\u044f: \u0447\u0430\u0441\u0442\u044c \u0440\u0435\u0447\u0438, \u043f\u0435\u0440\u0435\u0432\u043e\u0434 \u0441\u043b\u043e\u0432\u0430, \u0435\u0433\u043e \u0441\u0438\u043d\u043e\u043d\u0438\u043c\u044b (\u0435\u0441\u043b\u0438 \u0435\u0441\u0442\u044c). \u041d\u0443\u0436\u043d\u043e \u0432\u0435\u0440\u043d\u043e \u043d\u0430\u043f\u0438\u0441\u0430\u0442\u044c \u0441\u043b\u043e\u0432\u043e."
        }
    },
    {
