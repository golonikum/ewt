# Шаблон переменных окружения. Скопируйте в .env и подставьте свои значения:
#   cp .env.example .env        (Windows: copy .env.example .env)
#
# Файл .env читается docker compose автоматически и НЕ попадает в git.
# Реальные секреты держите только в нём или в переменных окружения хоста.

# --- Обязательно для production ---

# Пароль пользователя PostgreSQL. Задаётся при первой инициализации БД:
# если том с данными уже создан, смена значения здесь пароль в БД не изменит.
DB_PASSWORD=

# Ключ Django. Сгенерировать:
#   python -c "import random,string; print(''.join(random.SystemRandom().choice(string.ascii_letters+string.digits+'!@#$%^&*(-_=+)') for _ in range(50)))"
SECRET_KEY=

# Пароль суперпользователя, который создаётся при первом запуске контейнера.
DJANGO_ADMIN_PASSWORD=

# Домены через запятую, с которых отдаётся приложение. Обязательно при DEBUG=False.
ALLOWED_HOSTS=

# --- Необязательно (значения по умолчанию заданы в docker-compose.yml) ---

# DB_NAME=etrainer_golonru
# DB_USER=etrainer_golonru
# DJANGO_ADMIN_USER=admin

# Порт, на котором nginx слушает на хосте.
# HTTP_PORT=8000

# Отладка. В production переопределяется на False в docker-compose.prod.yml.
# DEBUG=True

# Число воркеров gunicorn.
# GUNICORN_WORKERS=3

# Почта. Консольный backend только печатает письма в лог и не блокирует запросы.
# Для реальной отправки: django.core.mail.backends.smtp.EmailBackend
# EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# ADMIN_EMAIL=admin@example.com
# SERVER_EMAIL=admin@example.com
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=25
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
