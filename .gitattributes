# Set default behavior to use LF line endings for all text files
* text=auto eol=lf

# Explicit LF for source files and scripts
*.py text eol=lf
*.sh text eol=lf
*.bash text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.csv text eol=lf
*.env text eol=lf
*.env.example text eol=lf
Dockerfile text eol=lf
Dockerfile.dev text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf
.editorconfig text eol=lf

# Windows batch files can use CRLF or LF (CRLF default for Windows cmd)
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.swf binary
*.pyc binary
*.pyo binary
*.db binary
